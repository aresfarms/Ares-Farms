# Ares/Furlong production backend activation template.
# Do not paste real secrets into this file. Put real values in the hosting
# provider secret manager or the local untracked .env file.

# Database
# Must include sslmode=verify-full or sslmode=verify-ca for production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Public application URL
NEXT_PUBLIC_BASE_URL=https://replace-with-production-domain.example
NEXTAUTH_URL=https://replace-with-production-domain.example

# Authentication
# Generate a strong random value of at least 32 characters.
NEXTAUTH_SECRET=replace-with-strong-production-nextauth-secret

# API perimeter
API_AUTH_ENFORCEMENT=required
RATE_LIMITING_ENABLED=true
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=120

# Controlled internal credential bridge
# This is not the long-term public identity provider.
AUTH_CREDENTIALS_MODE=email-allowlist
AUTH_CREDENTIAL_EMAIL_ALLOWLIST=operator@example.com,governance@example.com
AUTH_CREDENTIAL_SHARED_SECRET=replace-with-strong-temporary-shared-secret

# Role governance
ROLE_PROVISIONING_MODE=governed-admin-only

# Smoke test base URL for production-like verification.
BACKEND_SMOKE_BASE_URL=https://replace-with-production-domain.example

# Optional payment connector values.
# Keep unset until production payment connector promotion is approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Upload malware scanning
# Leave PROPERTY_UPLOAD_SCAN_URL blank to use the local ClamAV runtime on the host.
# Set PROPERTY_UPLOAD_SCAN_URL for a separately hosted scan service that implements
# the same JSON contract: { verdict, provider, detail }.
PROPERTY_UPLOAD_SCAN_MODE=enforce
PROPERTY_UPLOAD_SCAN_PROVIDER=clamav-local
PROPERTY_UPLOAD_SCAN_URL=
PROPERTY_UPLOAD_SCAN_TOKEN=
PROPERTY_UPLOAD_SCAN_CLAMAV_BINARY=/opt/homebrew/bin/clamscan
PROPERTY_UPLOAD_SCAN_CLAMAV_FRESHCLAM_BINARY=/opt/homebrew/bin/freshclam
PROPERTY_UPLOAD_SCAN_CLAMAV_DATABASE_DIR=/opt/homebrew/var/lib/clamav
PROPERTY_UPLOAD_SCAN_CLAMAV_MAX_SIGNATURE_AGE_DAYS=3

# Scheduler-authenticated property source refresh
# Point Cloud Scheduler or your platform cron at POST /api/internal/source-refresh
# and send this value as x-source-refresh-secret.
SOURCE_REFRESH_CRON_SECRET=replace-with-strong-refresh-secret
