# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Recovery Key.pdf

# personal financial / identity documents (never commit) —
# defense-in-depth; verify:no-personal-docs is the canonical gate.
Credit_Summary_*.pdf
*_Caitlin_Hudson.pdf
*_Stuart_Fraass.pdf
*_Frances_Fraass.pdf
*_ssn*
*social_security*
*passport*
*drivers_license*
*tax_return*
*bank_statement*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# Journey photo drop folder — raw phone photos carry GPS/EXIF; never commit them.
# Only the stripped, published copies under /public/journey/ are committed.
journey-photos/*
!journey-photos/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal source-review exports (generated, not served)
review-exports/

# Runtime operator state + audit ledger (not committed)
data/
